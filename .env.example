# LLM Agent Runtime 环境配置示例。复制为 .env 后按需修改。

# ---------- LLM（OpenAI 兼容接口）----------
# 默认组合：阿里云百炼（千问）。key 在 https://bailian.console.aliyun.com 获取。
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen-plus
# 预算超限时自动降级使用的便宜模型（留空则直接终止汇报）
LLM_MODEL_CHEAP=qwen-flash
# 换成别家 OpenAI 兼容服务时，只改上面三项即可，例如：
#   智谱 GLM ：LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#              LLM_API_KEY=<智谱 key>          LLM_MODEL=glm-4-flash
#   本地 Ollama：LLM_BASE_URL=http://localhost:11434/v1
#              LLM_API_KEY=ollama              LLM_MODEL=qwen2.5:7b

# ---------- 存储 ----------
# 本地零依赖模式（默认）：应用库与 LangGraph checkpoint 都走 SQLite
DATABASE_URL=sqlite+aiosqlite:///./data/agent.db
CHECKPOINT_DB=sqlite
# 完整模式（docker-compose）：切换为
# DATABASE_URL=postgresql+asyncpg://agent:agent@localhost:5432/agent
# CHECKPOINT_DB=postgres

# ---------- 任务队列 ----------
# local = 进程内 asyncio 队列（默认，开发演示）；celery = Redis 队列（生产）
QUEUE_MODE=local
REDIS_URL=redis://localhost:6379/0
MAX_CONCURRENT_TASKS=4

# ---------- 子 Agent（agent-as-tool）----------
MAX_CONCURRENT_SUBAGENTS=2
SUBAGENT_MAX_TOKENS=20000
SUBAGENT_MAX_STEPS=8

# ---------- 沙箱 ----------
# auto = 优先 Docker，daemon 不可用则回退本地受限子进程（仅开发）
SANDBOX_MODE=auto
ALLOW_UNSAFE_LOCAL_EXEC=true
SANDBOX_IMAGE=agent-sandbox:latest
SANDBOX_TIMEOUT_S=30
SANDBOX_MEM_LIMIT=256m
SANDBOX_NANO_CPUS=1000000000

# ---------- 预算与上下文 ----------
DEFAULT_MAX_TOKENS=60000
DEFAULT_MAX_STEPS=24
COMPRESS_THRESHOLD_TOKENS=8000
MAX_SELFHEAL_RETRIES=3

# ---------- 计划 DAG 与模式自适应 ----------
# Plan-and-Execute 连续 plan_defect 达到该次数 → 自动降级 ReAct（保留已完成步骤，
# 不再重规划空转）。设 0 关闭降级；计划 DAG 的 deps 声明无需配置（提示词驱动）。
ADAPTIVE_DOWNGRADE_AFTER_REPLANS=2

# ---------- 工具瞬时错误的退避重试 ----------
# 仅对声明 retry_transient 的只读工具生效（web_search / get_weather / db_query）。
# RETRY_MAX_ATTEMPTS=0 可完全关闭自动重试，退回「交给 critic 与模型层决策」的行为。
RETRY_MAX_ATTEMPTS=2
RETRY_BASE_DELAY_S=0.5
RETRY_MAX_DELAY_S=8.0

# ---------- 鉴权与多租户（默认开启） ----------
# 关闭仅限本机开发（任何人都可提交任务烧 token）
AUTH_ENABLED=true
# 本机免密放行（默认开启）：来自回环地址（127.0.0.1 / ::1）的请求无需 API Key，
# 落到 default 租户 —— 一键启动脚本打开的就是 127.0.0.1，因此页面开箱即用。
# **公网/局域网来源不是回环地址，仍要求 X-API-Key**：把服务经 ngrok 暴露给他人时
# 依然受保护，不会一泄漏地址就被无限提交任务。设 false 可让本机也强制校验密钥。
AUTH_LOCALHOST_BYPASS=true
# 可信反向代理跳数：默认 0 = 完全不信任 X-Forwarded-For（客户端可随意伪造它，
# 信了等于把鉴权交给攻击者）。仅在你自己的反代后面、且该代理会覆写此头时设为跳数。
TRUSTED_PROXY_HOPS=0
# 管理员密钥：留空则首次启动生成，与管理员/default 租户密钥一起写入 data/api_credentials.json
ADMIN_API_KEY=
# 新租户默认每日 token 配额（0 = 不限）。
# 深检索任务一次实耗 6万~13万 token：200000 只够 2~3 个深任务/天；默认 2000000
# ≈ 25 个深任务或数百个轻任务。防滥用仍由 L1~L3 与日总量上限兜底。
TENANT_DEFAULT_DAILY_TOKEN_QUOTA=2000000

# ---------- 限流（0 = 关闭该层） ----------
# L1/L2 分钟级计数的存储：memory（默认，单进程精确滑动窗口，零库往返）| db
# （预算落 rate_windows 表，多 worker 共享同一份额度；不改则多 worker 额度 ×N）
RATE_LIMIT_STORE=memory
# L1 每 IP 每分钟（/api/* 全部端点，含无效 key 的撞库请求）—— 最外层防滥用，保持不变
IP_RATE_LIMIT_PER_MIN=120
# L2 每租户每分钟提交任务数
TENANT_SUBMIT_PER_MIN=20
# L2b 每租户每日提交任务数
TENANT_DAILY_TASK_LIMIT=500
# L3 全局每日提交任务数（资金护栏）
GLOBAL_DAILY_TASK_LIMIT=3000

# ---------- 停机 ----------
# 优雅停机：先等在跑任务自然结束（排空），超时才取消。0 = 不排空直接取消
SHUTDOWN_DRAIN_TIMEOUT_S=10

# ---------- 可观测性（P2-5 / P2-6） ----------
# 日志脱敏：写入前遮蔽密钥/PII（sk-、Bearer、连接串密码、手机号、身份证、邮箱）。
# 关闭仅限本机排查用，生产勿关。
LOG_REDACT_ENABLED=true
# 自定义脱敏正则（逗号分隔，覆盖默认 8 条）。留空 = 用默认规则。
LOG_REDACT_PATTERNS=
# 日志采样：每 N 条 INFO 留 1 条；1 = 关闭采样。WARNING 及以上永不采样。
LOG_SAMPLE_RATE=1
# span 树：关闭可省一次落库（GET /api/tasks/{id}/spans 将返回空）。
SPANS_ENABLED=true
# 单任务 span 上限，超出截断并告警（防长任务撑爆表）。
SPANS_MAX_PER_TASK=500
# 直方图分桶边界（逗号或空格分隔的秒数，如 "0.05,0.1,0.5,1,5,30"）。
# 留空 = 内置 workload profile（LLM 0.05~60s / 工具 0.001~60s，各 13 档）。
METRICS_BUCKETS_TASK=
METRICS_BUCKETS_LLM=
METRICS_BUCKETS_TOOL=

# ---------- 工具 ----------
TOOL_DB_PATH=./data/demo.sqlite
WORKSPACE_DIR=./data/workspace
# 搜索源：auto（推荐，按 bocha→sogou→bing→ddgs 依次尝试并校验相关性）|
# bocha | sogou | bing | ddgs | mock
# 实测 cn.bing.com 对实体/英文查询会退化成「年份词条」保底结果，故不推荐单独用 bing。
SEARCH_PROVIDER=auto

# 博查 Web Search API（可选，但强烈建议）：正式搜索 API，不受反爬限流、结果自带来源与
# 发布时间，配置后 auto 会**优先**使用它。留空则完全跳过该源（零配置仍可开箱可用）。
# 获取：注册 https://open.bocha.cn → 控制台「API KEY 管理」→ 创建，新用户有免费资源包。
BOCHA_API_KEY=
