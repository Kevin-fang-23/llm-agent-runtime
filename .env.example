# LLM Agent Runtime 环境配置示例。复制为 .env 后按需修改。

# ---------- LLM（OpenAI 兼容接口）----------
# 智谱 GLM 示例：
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=
LLM_MODEL=glm-5.3-flash
# 预算超限时自动降级使用的便宜模型（留空则直接终止汇报）
LLM_MODEL_CHEAP=
# 本地 vLLM / Ollama 示例：
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b
# 阿里云百炼（千问）示例，key 在 bailian.console.aliyun.com 获取：
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_API_KEY=sk-xxx
# LLM_MODEL=qwen-plus

# ---------- 存储 ----------
# 本地零依赖模式（默认）：应用库与 LangGraph checkpoint 都走 SQLite
DATABASE_URL=sqlite+aiosqlite:///./data/agent.db
CHECKPOINT_DB=sqlite
# 完整模式（docker-compose）：切换为
# DATABASE_URL=postgresql+asyncpg://agent:agent@localhost:5432/agent
# CHECKPOINT_DB=postgres

# ---------- 任务队列 ----------
# local = 进程内 asyncio 队列（默认，开发演示）；celery = Redis 队列（生产）
QUEUE_MODE=local
REDIS_URL=redis://localhost:6379/0
MAX_CONCURRENT_TASKS=4

# ---------- 子 Agent（agent-as-tool）----------
MAX_CONCURRENT_SUBAGENTS=2
SUBAGENT_MAX_TOKENS=20000
SUBAGENT_MAX_STEPS=8

# ---------- 沙箱 ----------
# auto = 优先 Docker，daemon 不可用则回退本地受限子进程（仅开发）
SANDBOX_MODE=auto
ALLOW_UNSAFE_LOCAL_EXEC=true
SANDBOX_IMAGE=agent-sandbox:latest
SANDBOX_TIMEOUT_S=30
SANDBOX_MEM_LIMIT=256m
SANDBOX_NANO_CPUS=1000000000

# ---------- 预算与上下文 ----------
DEFAULT_MAX_TOKENS=60000
DEFAULT_MAX_STEPS=24
COMPRESS_THRESHOLD_TOKENS=8000
MAX_SELFHEAL_RETRIES=3

# ---------- 工具瞬时错误的退避重试 ----------
# 仅对声明 retry_transient 的只读工具生效（web_search / get_weather / db_query）。
# RETRY_MAX_ATTEMPTS=0 可完全关闭自动重试，退回「交给 critic 与模型层决策」的行为。
RETRY_MAX_ATTEMPTS=2
RETRY_BASE_DELAY_S=0.5
RETRY_MAX_DELAY_S=8.0

# ---------- 工具 ----------
TOOL_DB_PATH=./data/demo.sqlite
WORKSPACE_DIR=./data/workspace
SEARCH_PROVIDER=mock
